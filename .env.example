# Copy to .env and adjust. Never commit .env - it holds secrets.

# ---- Application ---------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# ---- Security ------------------------------------------------------------
# Long random string; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!2026

# ---- Database ------------------------------------------------------------
# Empty = SQLite at DATA_DIR/forensics.db. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://memtrace:password@localhost:5432/memtrace
DATABASE_URL=
POSTGRES_PASSWORD=memtrace-dev-password

# ---- Evidence & storage --------------------------------------------------
# DATA_DIR=./backend/data
MAX_UPLOAD_BYTES=34359738368
MIN_IMAGE_BYTES=1048576
ALLOWED_EXTENSIONS=.raw,.mem,.dmp,.vmem
VERIFY_HASH_ON_ANALYSIS=true

# ---- Volatility 3 ----------------------------------------------------------
# Empty = auto-detect ("vol" on PATH, else the installed volatility3 package)
VOLATILITY_CMD=
# Directory with offline Windows symbol packs (optional)
VOLATILITY_SYMBOLS_DIR=
# true = never download symbols from Microsoft/Volatility servers
VOLATILITY_OFFLINE=false
PLUGIN_TIMEOUT_SECONDS=900
ANALYSIS_WORKERS=1
DEEP_SCAN_MAX_PIDS=15
ENABLE_FILESCAN=false
YARA_SCAN_ALL_PROCESSES=false

# ---- AI --------------------------------------------------------------------
# deterministic | openai | ollama
AI_PROVIDER=deterministic
# openai-compatible: https://api.openai.com/v1, http://localhost:1234/v1 (LM Studio), http://localhost:8001/v1 (vLLM)
# ollama: http://localhost:11434   (from Docker: http://host.docker.internal:11434)
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_TEMPERATURE=0.1
AI_MAX_EVIDENCE_ITEMS=40

# ---- Docker published ports (change if 8080/8000 are reserved on your host) ----
FRONTEND_PORT=8080
BACKEND_PORT=8000
BACKEND_MEM_LIMIT=8g
